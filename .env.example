# Copy to a protected local environment file; never commit real credentials.
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=replace-with-a-long-random-password
TMALL_DB_PATH=data/dashboard.db
IMPORT_SCAN_ALLOWED_ROOTS=data/import-inbox
# 需要额外扫描目录时追加（Windows 用分号分隔）。示例：
# IMPORT_SCAN_ALLOWED_ROOTS=data/import-inbox;C:\path\to\export-folder;D:\another\source
# Optional server-side scan capability allowlists. Leave empty for local/loopback compatibility.
# IMPORT_SCAN_VIEW_USERS=operator;auditor
# IMPORT_SCAN_MANAGE_USERS=operator

# The checked PowerShell launcher accepts these as parameters.
# Default: 0.0.0.0:5000
