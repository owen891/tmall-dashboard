# 嗨贝海数据仪表盘 - .gitignore
# 集成 SCALE OS 认知脚手架

# ========================================
# 开发环境
# ========================================

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.temp
*.log
*.bak

# ========================================
# Python
# ========================================

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ========================================
# Node.js / 前端
# ========================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 构建产物
frontend/dist/
frontend/.vite/
frontend/.cache/

# ========================================
# 数据文件
# ========================================

# 数据库文件
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/db/*.db
*.db-shm
*.db-wal

# 备份文件
backend/data/backups/
backup/
*.backup
*.dump

# 上传的文件
backend/data/raw/
backend/data/uploads/
uploads/
temp/

# ========================================
# SCALE OS 脚手架状态
# ========================================

# Agent 状态（可以提交，方便团队协作）
# .agent/state/ 可以根据团队策略决定是否提交
.agent/state/*.backup
.agent/state/tmp*

# Checkpoint 缓存
.agent/checkpoints/tmp*

# 日志
.agent/logs/
*.log

# ========================================
# 测试和覆盖率
# ========================================

.pytest_cache/
.coverage
htmlcov/
.tox/

# ========================================
# Docker
# ========================================

docker-compose.override.yml
.dockerignore
.env.local

# ========================================
# 部署和环境配置
# ========================================

# 本地环境配置（不提交）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
config.local.json

# ========================================
# 系统文件
# ========================================

# 操作系统文件
.DS_Store
Thumbs.db
.fseventsd
.Spotlight-V100
.Trashes
ehthumbs.db

# 大型临时文件
*.zip
*.tar.gz
*.rar
*.7z
*.iso
*.dmg

# 敏感数据
*.key
*.pem
*.crt
*.cert
secrets/
credentials/
private/
