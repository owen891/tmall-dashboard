# 海贝海数据仪表盘 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# 必填：JWT签名密钥（生产环境必须设置，否则每次重启token失效）
SECRET_KEY=your-secret-key-here-change-this

# 应用调试模式（生产环境必须为 false）
DEBUG=true

# 数据库URL（默认使用SQLite）
# DATABASE_URL=sqlite:///./data/dashboard.db
# PostgreSQL示例: postgresql://user:password@localhost:5432/dashboard

# JWT Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS 允许的前端源（多个用逗号分隔）
# BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI API Key（智能导入功能需要）
# OPENAI_API_KEY=sk-xxx

# Redis URL（可选，用于缓存）
# REDIS_URL=redis://localhost:6379/0

# 缓存TTL（秒）
# CACHE_TTL=300

# 佣金率（默认0.06）
# COMMISSION_RATE=0.06

# 运费率（默认0.02）
# FREIGHT_RATE=0.02

# 行业平均CTR（默认0.05）
# INDUSTRY_CTR=0.05
